[project]
name = "dbt-databricks-pipeline"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
authors = [
    { name = "chanu.tha", email = "chanu.ctha@gmail.com" }
]
requires-python = ">=3.13"
dependencies = [
    "dbt>=2.0.9",
]

[project.scripts]
dbt-databricks-pipeline = "dbt_databricks_pipeline:main"

[build-system]
requires = ["uv_build>=0.13.6,<0.14.0"]
build-backend = "uv_build"
